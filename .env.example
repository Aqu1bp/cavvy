# Optional. The easiest way to add keys is to run `harness` and type /login
# (or `harness auth add`): keys then go into your OS keychain, not a file.
#
# If you prefer environment variables, copy this file to .env in the harness
# folder (or to ~/.harness/.env). Only these two files are read; a .env in the
# project you're working on is never loaded. Fill in any number of providers;
# /model lists the models from all of them together.

# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
# DEEPSEEK_API_KEY=
# XAI_API_KEY=
# MISTRAL_API_KEY=
# TOGETHER_API_KEY=
# FIREWORKS_API_KEY=
# CEREBRAS_API_KEY=

# Web search backends (optional; DuckDuckGo is used when neither is set and
# the model's provider has no built-in search).
# BRAVE_API_KEY=
# TAVILY_API_KEY=

# Default model as provider:model (optional; /model remembers your choice).
# HARNESS_MODEL=anthropic:claude-opus-5-5

# The original single-provider format still works. The key is only used if
# BASE_URL's host is a known provider, and it's only ever sent to that host.
# BASE_URL=https://openrouter.ai/api/v1
# API_KEY=
# MODEL=anthropic/claude-sonnet-5.5
