{
  "name": "cavvy",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "license": "MIT",
  "bin": {
    "cavvy": "bin/cavvy"
  },
  "exports": {
    "./sdk": "./src/sdk/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "start": "bun --no-env-file --config=bunfig.toml src/index.ts",
    "dev": "bun --no-env-file --config=bunfig.toml src/index.ts",
    "build": "bun build --compile --no-compile-autoload-dotenv --no-compile-autoload-bunfig --outfile dist/cavvy src/index.ts",
    "test": "bun --no-env-file test",
    "typecheck": "tsc --noEmit -p .",
    "gui": "bun --no-env-file --config=bunfig.toml src/index.ts gui",
    "gui:build": "cd gui && bun run build",
    "gui:dev": "bun --no-env-file --config=bunfig.toml scripts/gui-dev.ts",
    "gui:demo": "bun --no-env-file --config=bunfig.toml scripts/gui-demo.ts",
    "gui:typecheck": "cd gui && bun run typecheck",
    "desktop:dev": "bun --no-env-file --config=bunfig.toml scripts/desktop-dev.ts",
    "desktop:build": "cd desktop-electron && bun install && bun pack.ts",
    "desktop:typecheck": "cd desktop-electron && bun run typecheck",
    "desktop:install": "bun --no-env-file --config=bunfig.toml scripts/install-desktop.ts",
    "desktop:update": "bun --no-env-file --config=bunfig.toml scripts/update-desktop.ts",
    "perf:bench": "bun desktop-electron/perf-bench.ts",
    "perf:budgets": "bun scripts/perf-budgets.ts bundle",
    "review:eval": "bun --no-env-file --config=bunfig.toml scripts/review-eval.ts",
    "sdk:example": "bun --no-env-file --config=bunfig.toml scripts/sdk-demo.ts",
    "sdk:bench": "bun --no-env-file --config=bunfig.toml scripts/sdk-bench.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.133.0"
  }
}
