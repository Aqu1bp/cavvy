{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Harness",
    "version": "1.0.0",
    "identifier": "dev.harness.desktop",
    "build": {
        "frontendDist": "../../gui/dist",
        "devUrl": "http://localhost:5173",
        "beforeDevCommand": "cd ../gui && bun run dev",
        "beforeBuildCommand": "cd ../gui && bun install && bun run build && cd .. && bun scripts/build-sidecar.ts"
    },
    "app": {
        "withGlobalTauri": false,
        "windows": [
            {
                "label": "main",
                "title": "Harness",
                "width": 1360,
                "height": 880,
                "minWidth": 720,
                "minHeight": 480,
                "center": true,
                "titleBarStyle": "Overlay",
                "hiddenTitle": true,
                "dragDropEnabled": false,
                "trafficLightPosition": {
                    "x": 18,
                    "y": 22
                }
            }
        ],
        "security": {
            "csp": {
                "default-src": "'self'",
                "script-src": "'self'",
                "style-src": "'self' 'unsafe-inline'",
                "img-src": "'self' data: blob:",
                "font-src": "'self' data:",
                "connect-src": "'self' ipc: http://ipc.localhost ws://127.0.0.1:*",
                "worker-src": "'self' blob:",
                "object-src": "'none'",
                "base-uri": "'none'",
                "frame-src": "'none'",
                "form-action": "'none'"
            },
            "devCsp": {
                "default-src": "'self'",
                "script-src": "'self'",
                "style-src": "'self' 'unsafe-inline'",
                "img-src": "'self' data: blob:",
                "font-src": "'self' data:",
                "connect-src": "'self' ipc: http://ipc.localhost ws://127.0.0.1:* ws://localhost:5173",
                "worker-src": "'self' blob:",
                "object-src": "'none'"
            }
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "category": "DeveloperTool",
        "shortDescription": "A coding agent for any model provider",
        "longDescription": "Harness reads, edits and runs code in your projects with models from any provider, asking before anything risky.",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "externalBin": [
            "binaries/harness"
        ],
        "macOS": {
            "minimumSystemVersion": "12.0"
        },
        "linux": {
            "deb": {
                "depends": []
            }
        }
    }
}
