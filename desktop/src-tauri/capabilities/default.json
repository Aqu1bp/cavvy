{
    "$schema": "../gen/schemas/desktop-schema.json",
    "identifier": "default",
    "description": "What the GUI may ask the app to do. No shell access: only the Rust side starts processes.",
    "windows": [
        "main"
    ],
    "permissions": [
        "core:default",
        "core:window:allow-set-theme",
        "core:window:allow-start-dragging",
        "dialog:allow-open",
        "notification:default",
        "opener:default"
    ]
}
